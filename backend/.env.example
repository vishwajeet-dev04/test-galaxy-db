# Galaxy Performance Tracker — Backend Environment Variables
# Copy this file to backend/.env and fill in real values

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string. Never use the old public placeholder.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=150
# Set to 1 only on a trusted machine if you need /docs
GALAXY_DOCS=0

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (default). Set for Postgres on Render:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Vtiger CRM Integration ────────────────────────────────────────────────────
# The base URL of your client's Vtiger server (no trailing slash)
VTIGER_URL=http://crmgoaplpoc.centralindia.cloudapp.azure.com

# Vtiger admin username
VTIGER_USERNAME=admin

# API Access Key — found in Vtiger: My Preferences → Access Key
# This is NOT the web login password
VTIGER_ACCESS_KEY=your_access_key_here
