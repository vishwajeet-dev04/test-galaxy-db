# Galaxy Performance Tracker — Backend Environment Variables
# Copy this file to backend/.env and fill in real values

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a long random string. Never use the old public placeholder.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=150
# Public URL used inside magic-link emails (no trailing slash)
GALAXY_PUBLIC_URL=http://localhost:5173
MAGIC_LINK_TTL_MINUTES=15
# Set to 1 only on a trusted machine if you need /docs
GALAXY_DOCS=0

# ── SMTP (Google Workspace or Outlook / Microsoft 365) ────────────────────────
# Leave SMTP_HOST empty locally — magic links are printed in the backend log.
# Google example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=service@getafixtechnologies.com
#   SMTP_PASSWORD=app-password-here
#   SMTP_FROM=service@getafixtechnologies.com
# Outlook / M365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=noreply@clientdomain.com
#   SMTP_PASSWORD=...
#   SMTP_FROM=noreply@clientdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (default). Set for Postgres on Render:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Vtiger CRM Integration ────────────────────────────────────────────────────
# The base URL of your client's Vtiger server (no trailing slash)
VTIGER_URL=http://crmgoaplpoc.centralindia.cloudapp.azure.com

# Vtiger admin username
VTIGER_USERNAME=admin

# API Access Key — found in Vtiger: My Preferences → Access Key
# This is NOT the web login password
VTIGER_ACCESS_KEY=your_access_key_here
