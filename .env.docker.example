# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# App secrets (SECRET_KEY, VTIGER_URL, VTIGER_USERNAME, VTIGER_ACCESS_KEY) stay in backend/.env.

POSTGRES_USER=galaxy
# Used inside a URL: avoid @ : / ? # % or URL-encode them (e.g. @ -> %40).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=galaxy

# Host port for the web container. Use 80 on the VM once systemd nginx is stopped.
WEB_PORT=8088
